diff --git a/php-src/Zend/zend_qsort.c b/php-src/Zend/zend_qsort.c
index 98cf8f7..bd04bff 100644
--- a/php-src/Zend/zend_qsort.c
+++ b/php-src/Zend/zend_qsort.c
@@ -118,9 +118,18 @@ ZEND_API void zend_qsort_r(void *base, size_t nmemb, size_t siz, compare_r_func_
 	}
 }
 
+/* zend_qsort_r() calls the comparison function with an extra argument.
+ * Calling a two-argument compare_func_t that way traps in WebAssembly, where
+ * an indirect call must match the callee's signature, so pass it through a
+ * three-argument function instead. */
+static int zend_qsort_compare(const void *a, const void *b TSRMLS_DC, void *compare)
+{
+	return ((compare_func_t)compare)(a, b TSRMLS_CC);
+}
+
 ZEND_API void zend_qsort(void *base, size_t nmemb, size_t siz, compare_func_t compare TSRMLS_DC)
 {
-	zend_qsort_r(base, nmemb, siz, (compare_r_func_t)compare, NULL TSRMLS_CC);
+	zend_qsort_r(base, nmemb, siz, zend_qsort_compare, (void *)compare TSRMLS_CC);
 }
 
