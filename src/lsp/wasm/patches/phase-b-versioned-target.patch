+            | "io"
+    )
+}
+// Tokenize strings/comments/attributes instead of matching declaration-looking prose.
+fn tokens(source: &str) -> Vec<&str> {
+    let b = source.as_bytes();
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < b.len() {
+        let start = i;
+        if b[i].is_ascii_whitespace() {
+            i += 1;
+            continue;
+        }
+        if source[i..].starts_with("//") || (b[i] == b'#' && !source[i..].starts_with("#[")) {
+            i += source[i..].find('\n').unwrap_or(b.len() - i);
+            continue;
+        }
+        if source[i..].starts_with("/*") {
+            i += 2 + source[i + 2..].find("*/").unwrap_or(b.len() - i - 2);
+            i = (i + 2).min(b.len());
+            if source[start..].starts_with("/**") {
+                out.push(&source[start..i]);
+            }
+            continue;
+        }
+        if source[i..].starts_with("<<<") {
+            // PHP's flexible heredoc/nowdoc end marker may be indented. Treat the body as opaque.
+            let header_end = source[i..].find('\n').map_or(b.len(), |n| i + n);
+            let label = source[i + 3..header_end].trim().trim_matches(['\'', '"']);
+            if !label.is_empty()
+                && label
+                    .bytes()
+                    .all(|c| c.is_ascii_alphanumeric() || c == b'_')
+            {
+                i = (header_end + 1).min(b.len());
+                while i < b.len() {
+                    let end = source[i..].find('\n').map_or(b.len(), |n| i + n);
+                    let line = source[i..end].trim_start_matches([' ', '\t']);
+                    if let Some(rest) = line.strip_prefix(label)
+                        && !rest
+                            .bytes()
+                            .next()
+                            .is_some_and(|c| c.is_ascii_alphanumeric() || c == b'_')
+                    {
+                        i = end - line.len() + label.len();
+                        break;
+                    }
+                    i = (end + 1).min(b.len());
+                }
+                continue;
+            }
+        }
+        if b[i] == b'\'' || b[i] == b'"' || b[i] == b'`' {
+            let quote = b[i];
+            i += 1;
+            while i < b.len() {
+                if b[i] == b'\\' {
+                    i = (i + 2).min(b.len());
+                } else if b[i] == quote {
+                    i += 1;
+                    break;
+                } else {
+                    i += 1;
+                }
+            }
+        } else if b[i].is_ascii_alphanumeric() || b[i] == b'_' || b[i] == b'\\' || b[i] >= 128 {
+            i += 1;
+            while i < b.len()
+                && (b[i].is_ascii_alphanumeric() || b[i] == b'_' || b[i] == b'\\' || b[i] >= 128)
+            {
+                i += 1;
+            }
+        } else {
+            i += 1;
+        }
+        out.push(&source[start..i]);
+    }
+    out
+}
+fn unquote(s: &str) -> &str {
+    s.trim_matches(['\'', '"'])
+}
+fn availability_attribute(attrs: &str, imports: &[(&str, &str)], namespace: &str) -> (u16, u16) {
+    let normalized = attrs.replace("# [", "#[");
+    let t = tokens(&normalized);
+    let mut nesting = 0usize;
+    for i in 0..t.len().saturating_sub(1) {
+        if t[i] == "(" {
+            nesting += 1;
+            continue;
+        }
+        if t[i] == ")" {
+            nesting = nesting.saturating_sub(1);
+            continue;
+        }
+        if nesting != 0 || !is_availability_attribute(t[i], imports, namespace) || t[i + 1] != "(" {
+            continue;
+        }
+        let mut from = 0;
+        let mut to = u16::MAX;
+        let mut j = i + 2;
+        // Only this attribute's own argument list contributes bounds.
+        while j < t.len() && t[j] != ")" {
+            if (t[j] == "from" || t[j] == "to") && t.get(j + 1) == Some(&":") {
+                if let Some(value) = t.get(j + 2).and_then(|v| version(unquote(v))) {
+                    if t[j] == "from" {
+                        from = value;
+                    } else {
+                        to = value;
+                    }
+                }
+                j += 3;
+            } else if j == i + 2 {
+                if let Some(value) = version(unquote(t[j])) {
+                    from = value;
+                }
+                j += 1;
+            } else {
+                j += 1;
+            }
+        }
+        return (from, to);
+    }
+    (0, u16::MAX)
+}
+pub fn entries(source: &str, php_domain: bool) -> Vec<Entry> {
+    let t = tokens(source);
+    let mut imports: Vec<(String, String)> = Vec::new();
+    let mut i = 0;
+    let mut doc = "";
+    let mut attrs = String::new();
+    let mut ns = String::new();
+    let mut depth = 0usize;
+    let mut class_depth = None;
+    let mut pending_class = false;
+    let mut ns_depth = None;
+    let mut result = Vec::new();
+    while i < t.len() {
+        let token = t[i];
+        if token.starts_with("/**") {
+            doc = token;
+            attrs.clear();
+            i += 1;
+            continue;
+        }
+        if token == "#" && t.get(i + 1) == Some(&"[") {
+            let start = i;
+            i += 2;
+            let mut n = 1;
+            while i < t.len() && n > 0 {
+                if t[i] == "[" {
+                    n += 1;
+                }
+                if t[i] == "]" {
+                    n -= 1;
+                }
+                i += 1;
+            }
+            attrs.push_str(&t[start..i].join(" "));
+            continue;
+        }
+        if token == "namespace" {
+            imports.clear();
+            if let Some(name) = t.get(i + 1) {
+                if *name != "{" {
+                    ns = name.trim_start_matches('\\').to_string();
+                } else {
+                    ns.clear();
+                }
+            }
+            if let Some(next) = t[i + 1..].iter().position(|v| *v == "{" || *v == ";")
+                && t[i + 1 + next] == "{"
+            {
+                ns_depth = Some(depth + 1);
+            }
+            doc = "";
+            attrs.clear();
+            i += 1;
+            continue;
+        }
+        if token == "use" && class_depth.is_none() && depth == ns_depth.unwrap_or(0) {
+            let end = t[i..]
+                .iter()
+                .position(|v| *v == ";")
+                .map_or(t.len(), |n| i + n);
+            if !matches!(t.get(i + 1), Some(&"function") | Some(&"const")) {
+                let parts = &t[i + 1..end];
+                let group = parts.iter().position(|v| *v == "{");
+                let prefix = group.map_or("", |g| parts[g - 1]);
+                let body = group.map_or(parts, |g| {
+                    &parts[g + 1..parts.iter().rposition(|v| *v == "}").unwrap_or(parts.len())]
+                });
+                for item in body.split(|v| *v == ",") {
+                    if let Some(name) = item.first() {
+                        let target = format!("{}{}", prefix, name)
+                            .trim_start_matches('\\')
+                            .to_string();
+                        let alias = if item.get(1) == Some(&"as") {
+                            item.get(2).copied().unwrap_or("")
+                        } else {
+                            target.rsplit('\\').next().unwrap_or(&target)
+                        };
+                        imports.retain(|(old, _)| !old.eq_ignore_ascii_case(alias));
+                        imports.push((alias.to_string(), target));
+                    }
+                }
+            }
+            i = (end + 1).min(t.len());
+            continue;
+        }
+        if token == "{" {
+            depth += 1;
+            if pending_class {
+                class_depth = Some(depth);
+                pending_class = false;
+            }
+            doc = "";
+            attrs.clear();
+            i += 1;
+            continue;
+        }
+        if token == "}" {
+            if class_depth == Some(depth) {
+                class_depth = None;
+            }
+            if ns_depth == Some(depth) {
+                ns.clear();
+                imports.clear();
+                ns_depth = None;
+            }
+            depth = depth.saturating_sub(1);
+            doc = "";
+            attrs.clear();
+            i += 1;
+            continue;
+        }
+        if token == "const" {
+            let mut end = i + 1;
+            let mut nesting = 0usize;
+            let mut start = end;
+            while end < t.len() {
+                match t[end] {
+                    "(" | "[" | "{" => nesting += 1,
+                    ")" | "]" | "}" => nesting = nesting.saturating_sub(1),
+                    "," | ";" if nesting == 0 => {
+                        let declarator = &t[start..end];
+                        if class_depth.is_none()
+                            && let Some(eq) = declarator.iter().position(|v| *v == "=")
+                            && eq > 0
+                        {
+                            let name = declarator[eq - 1];
+                            let refs = imports
+                                .iter()
+                                .map(|(a, t)| (a.as_str(), t.as_str()))
+                                .collect::<Vec<_>>();
+                            let (attr_from, attr_to) = availability_attribute(&attrs, &refs, &ns);
+                            result.push(Entry {
+                                kind: "constant",
+                                name: if ns.is_empty() {
+                                    name.to_string()
+                                } else {
+                                    format!("{ns}\\{name}")
+                                },
+                                from: doc_version(doc, "@since", php_domain)
+                                    .unwrap_or(0)
+                                    .max(attr_from),
+                                to: attr_to,
+                                removed: doc_version(doc, "@removed", php_domain)
+                                    .unwrap_or(u16::MAX),
+                            });
+                        }
+                        start = end + 1;
+                        if t[end] == ";" {
+                            break;
+                        }
+                    }
+                    _ => {}
+                }
+                end += 1;
+            }
+            doc = "";
+            attrs.clear();
+            i = (end + 1).min(t.len());
+            continue;
+        }
+        let kind = match token {
+            "function" => Some("function"),
+            "class" | "interface" | "trait" | "enum" => Some("class"),
+            "const" | "define" => Some("constant"),
+            _ => None,
+        };
+        if let Some(kind) = kind {
+            let mut n = i + 1;
+            if t.get(n) == Some(&"&") {
+                n += 1;
+            }
+            if token == "define" {
+                if t.get(n) != Some(&"(") {
+                    i += 1;
+                    continue;
+                }
+                n += 1;
+            }
+            if let Some(raw) = t.get(n) {
+                let name = unquote(raw);
+                let declaration = name
+                    .bytes()
+                    .next()
+                    .is_some_and(|b| b.is_ascii_alphabetic() || b == b'_' || b >= 128);
+                if declaration
+                    && class_depth.is_none()
+                    && t.get(i.wrapping_sub(1)) != Some(&":")
+                    && !(kind == "class" && t.get(i.wrapping_sub(1)) == Some(&"new"))
+                {
+                    let fqn = if ns.is_empty() || token == "define" {
+                        name.to_string()
+                    } else {
+                        format!("{ns}\\{name}")
+                    };
+                    let refs = imports
+                        .iter()
+                        .map(|(a, t)| (a.as_str(), t.as_str()))
+                        .collect::<Vec<_>>();
+                    let (attr_from, attr_to) = availability_attribute(&attrs, &refs, &ns);
+                    let from = doc_version(doc, "@since", php_domain)
+                        .unwrap_or(0)
+                        .max(attr_from);
+                    let removed = doc_version(doc, "@removed", php_domain).unwrap_or(u16::MAX);
+                    let to = attr_to;
+                    result.push(Entry {
+                        kind,
+                        name: fqn,
+                        from,
+                        to,
+                        removed,
+                    });
+                }
+            }
+            if kind == "class" && t.get(i.wrapping_sub(1)) != Some(&":") {
+                pending_class = true;
+            }
+            if kind == "function"
+                && t.get(n).is_some_and(|name| {
+                    name.bytes()
+                        .next()
+                        .is_some_and(|b| b.is_ascii_alphabetic() || b == b'_' || b >= 128)
+                })
+            {
+                i = n;
+            }
+            doc = "";
+            attrs.clear();
+        }
+        if token == ";" {
+            doc = "";
+            attrs.clear();
+        }
+        i += 1;
+    }
+    result
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn domain_and_owner_are_not_inferred_from_indentation() {
+        let src = "<?php namespace Random { /** @since 7.0 */ function random_bytes() {} /** @since 8.2 */ class Randomizer { /** @since 8.3 */ function getFloat() {} } }";
+        assert_eq!(
+            entries(src, true),
+            vec![
+                Entry {
+                    kind: "function",
+                    name: "Random\\random_bytes".into(),
+                    from: 700,
+                    to: 65535,
+                    removed: 65535
+                },
+                Entry {
+                    kind: "class",
+                    name: "Random\\Randomizer".into(),
+                    from: 802,
+                    to: 65535,
+                    removed: 65535
+                }
+            ]
+        );
+    }
+    #[test]
+    fn extension_release_is_not_a_php_release() {
+        let src = "<?php /** @since 5.2.0 */ function redis_example() {}";
+        assert_eq!(entries(src, false)[0].from, 0);
+        assert_eq!(entries(src, true)[0].from, 502);
+    }
+    #[test]
+    fn ranges_and_removals_are_per_declaration() {
+        let src = "<?php /** @removed 8.0 */ #[PhpStormStubsElementAvailable(from: '5.6', to: '7.4')] function old_name() {} /** @since 8.1 */ define('FUTURE', 1);";
+        let e = entries(src, true);
+        assert_eq!((e[0].from, e[0].to, e[0].removed), (506, 704, 800));
+        assert_eq!(e[1].from, 801);
+    }
+
+    #[test]
+    fn unrelated_attribute_bounds_are_not_php_availability() {
+        let src = "<?php #[Unrelated(from: '8.5')] function existing() {}";
+        assert_eq!(
+            (entries(src, true)[0].from, entries(src, true)[0].to),
+            (0, 65535)
+        );
+    }
+    #[test]
+    fn attribute_bounds_do_not_bleed_across_attributes() {
+        let src = "<?php #[Unrelated(from: '8.5'), PhpStormStubsElementAvailable(to: '7.4'), Other(from: '8.3')] function existing() {}";
+        assert_eq!(
+            (entries(src, true)[0].from, entries(src, true)[0].to),
+            (0, 704)
+        );
+    }
+    #[test]
+    fn availability_fqn_alias_and_positional_are_recognized() {
+        let src = "<?php use JetBrains\\PhpStorm\\Internal\\PhpStormStubsElementAvailable as Available; #[Available('8.1')] function first() {} #[\\JetBrains\\PhpStorm\\Internal\\PhpStormStubsElementAvailable(from: '8.2')] function second() {}";
+        assert_eq!(
+            entries(src, true)
+                .iter()
+                .map(|e| e.from)
+                .collect::<Vec<_>>(),
+            vec![801, 802]
+        );
+    }
+    #[test]
+    fn unrelated_namespace_and_nested_attributes_are_not_availability() {
+        let src = "<?php use Other\\PhpStormStubsElementAvailable; #[PhpStormStubsElementAvailable(from: '8.5')] function first() {} #[Unrelated(new \\JetBrains\\PhpStorm\\Internal\\PhpStormStubsElementAvailable(from: '8.5'))] function second() {}";
+        assert_eq!(
+            entries(src, true)
+                .iter()
+                .map(|e| e.from)
+                .collect::<Vec<_>>(),
+            vec![0, 0]
+        );
+    }
+    #[test]
+    fn since_does_not_leak_from_classes_constants_or_comments_to_functions() {
+        let source = "<?php /** @since 8.0.2 */ #[Pure] function introduced_in_core(): void {} /** @since 8.1 */ class Type { /** @since 8.2 */ public function method_since(): void {} } /** @since 8.3 */ // function mentioned is not a declaration\nconst DOCUMENTED_CONSTANT = 'function not_a_function';";
+        let got = entries(source, true)
+            .into_iter()
+            .filter(|e| e.kind == "function")
+            .map(|e| (e.name, e.from))
+            .collect::<Vec<_>>();
+        assert_eq!(got, vec![("introduced_in_core".to_string(), 800)]);
+    }
+}
