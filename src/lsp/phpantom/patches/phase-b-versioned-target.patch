+/// Read PHP introduction versions from documented, top-level functions.
+///
+/// Callers must restrict this to PHP core stub files: extensions use
+/// `@since` for their own release versions.
+pub(crate) fn function_since_versions(source: &str) -> Vec<(String, u8, u8)> {
+    let mut result = Vec::new();
+    let mut search_from = 0;
+    while let Some(relative_tag) = source[search_from..].find("@since") {
+        let tag_pos = search_from + relative_tag;
+        let Some(doc_end) = source[tag_pos..]
+            .find("*/")
+            .map(|offset| tag_pos + offset + 2)
+        else {
+            break;
+        };
+        search_from = doc_end;
+        let Some(doc_start) = source[..tag_pos].rfind("/**") else {
+            continue;
+        };
+        let Some((major, minor)) = source[doc_start..doc_end]
+            .lines()
+            .filter_map(|line| line.split_once("@since").map(|(_, value)| value))
+            .find_map(parse_php_version)
+        else {
+            continue;
+        };
+        let after = &source[doc_end..];
+        let after = &after[..after.find("/**").unwrap_or(after.len())];
+        if let Some(name) = documented_top_level_function(after) {
+            result.push((name.to_string(), major, minor));
+        }
+    }
+    result
+}
+
+fn parse_php_version(value: &str) -> Option<(u8, u8)> {
+    let version = value
+        .trim()
+        .split(|character: char| !(character.is_ascii_digit() || character == '.'))
+        .find(|part| !part.is_empty())?;
+    let mut parts = version.split('.');
+    Some((parts.next()?.parse().ok()?, parts.next()?.parse().ok()?))
+}
+
+fn documented_top_level_function(text: &str) -> Option<&str> {
+    let mut in_block_comment = false;
+    let mut in_attribute = false;
+    for line in text.lines() {
+        let trimmed = line.trim();
+        if in_block_comment {
+            in_block_comment = !trimmed.contains("*/");
+            continue;
+        }
+        if trimmed.is_empty() || trimmed.starts_with("//") {
+            continue;
+        }
+        if trimmed.starts_with("/*") {
+            in_block_comment = !trimmed.contains("*/");
+            continue;
+        }
+        if in_attribute {
+            in_attribute = !trimmed.contains(']');
+            continue;
+        }
+        if trimmed.starts_with("#[") {
+            in_attribute = !trimmed.contains(']');
+            continue;
+        }
+        if line.trim_start() != line {
+            return None;
+        }
+        let rest = trimmed
+            .strip_prefix("function ")
+            .or_else(|| trimmed.strip_prefix("function&"))?;
+        return function_identifier(rest);
+    }
+    None
+}
+
+fn function_identifier(rest: &str) -> Option<&str> {
+    let rest = rest.trim_start_matches([' ', '\t', '&']);
+    let length = rest
+        .bytes()
+        .take_while(|byte| byte.is_ascii_alphanumeric() || *byte == b'_' || *byte >= 0x80)
+        .count();
+    (length > 0).then(|| &rest[..length])
+}
+
+#[cfg(test)]
+mod tests {
+    use super::function_since_versions;
+
+    #[test]
+    fn since_metadata_is_attached_only_to_the_documented_top_level_function() {
+        let source = r#"
+/** @since 8.0.2 introduced in core */
+#[Pure]
+function introduced_in_core(): void {}
+
+/** @since 8.1 */
+class VersionedType {
+    /** @since 8.2 */
+    public function method_since(): void {}
+}
+
+/** @since 8.3 */
+// function mentioned in a comment is not a declaration
+const DOCUMENTED_CONSTANT = 'function not_a_function';
+"#;
+
+        assert_eq!(
+            function_since_versions(source),
+            vec![("introduced_in_core".to_string(), 8, 0)]
+        );
+    }
+}
diff --git a/tests/native_versioned_embedded.rs b/tests/native_versioned_embedded.rs
