+fn existing_uppercase_constant_name_remains_a_name_context() {
+    assert!(detect("<?php\nclass C {\npublic const ST", 2, 15).is_none());
+}
+
+#[test]
+fn class_constant_compound_types_keep_the_declaration_site_and_prefix() {
+    for tail in ["string|in", "?str", "A&B", "(A&B)|str"] {
+        let source = format!("<?php\nclass C {{ const {tail}");
+        let context = detect(&source, 1, source.lines().last().unwrap().len() as u32).unwrap();
+        assert_eq!(context.site, TypeHintSite::ClassConstant);
+        assert!(!context.preceding_types.is_empty());
+        assert!(!declaration_available(
+            &context,
+            crate::types::PhpVersion::new(8, 2)
+        ));
+        assert!(declaration_available(
+            &context,
+            crate::types::PhpVersion::new(8, 3)
+        ));
+    }
+    assert!(detect("<?php\nclass C { const string NAME", 1, 27).is_none());
+}
+
+#[test]
+fn previous_native_type_keys_are_case_insensitive_without_rewriting_user_names() {
+    let source = "<?php\nfunction f(): MiXeD|in";
+    let context = detect(source, 1, source.lines().last().unwrap().len() as u32).unwrap();
+    assert_eq!(context.preceding_types, " MiXeD|");
+    assert!(!declaration_available(
+        &context,
+        crate::types::PhpVersion::new(8, 0)
+    ));
+}
+
+#[test]
+fn constant_import_is_not_a_native_class_constant_type() {
+    assert!(detect("<?php\nuse const str", 1, 13).is_none());
+    assert!(detect("<?php\nUsE CoNsT str", 1, 13).is_none());
+}
