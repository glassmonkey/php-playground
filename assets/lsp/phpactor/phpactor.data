     * @param $delete [optional]
     */
    #[Pure]
    public function getBool($name, $defval, $delete) {}

    /**
     * @param $name
     * @param $defval [optional]
     * @param $delete [optional]
     */
    #[Pure]
    public function getInt($name, $defval, $delete) {}

    /**
     * @param $name
     * @param $defval [optional]
     * @param $delete [optional]
     */
    #[Pure]
    public function getFloat($name, $defval, $delete) {}

