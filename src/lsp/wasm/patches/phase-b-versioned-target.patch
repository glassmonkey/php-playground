+//! Metadata-only PHP stub scanner, shared by cold indexes and stub parsing.
+//! Numeric @since/@removed tags are PHP versions only for bundled PHP domains.
+#[path = "../src/stub_metadata.rs"]
+mod metadata;
+pub use metadata::PHP_DOC_MARKER;
+use metadata::{doc_version, is_availability_attribute, version};
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Entry {
+    pub kind: &'static str,
+    pub name: String,
+    pub from: u16,
+    pub to: u16,
+    pub removed: u16,
+}
+pub fn php_version_domain(path: &str) -> bool {
+    matches!(
+        path.split('/').next().unwrap_or(""),
+        "Core"
+            | "standard"
+            | "SPL"
+            | "Reflection"
+            | "date"
+            | "random"
+            | "json"
+            | "pcre"
+            | "hash"
