 /// built without them.
 pub const STUBS_VERSION: &str = env!("PHPANTOM_STUBS_VERSION");
 
+/// Whether a function declared by phpstorm-stubs exists in this PHP release.
+pub(crate) fn stub_function_available(name: &str, version: crate::types::PhpVersion) -> bool {
+    stub_symbol_available("function", name, version)
+}
+pub(crate) fn stub_symbol_available(
+    kind: &str,
+    name: &str,
+    version: crate::types::PhpVersion,
+) -> bool {
+    let name = if kind == "constant" {
+        name.to_string()
+    } else {
+        name.to_ascii_lowercase()
+    };
+    let key = format!("{kind}:{name}");
+    let entries = STUB_AVAILABILITY;
+    let start = entries.partition_point(|entry| entry.0 < key.as_str());
+    let matching = entries[start..].iter().take_while(|entry| entry.0 == key);
+    let v = u16::from(version.major) * 100 + u16::from(version.minor);
+    let mut found = false;
+    for (_, from, to, removed) in matching {
+        found = true;
+        if v >= *from && v <= *to && v < *removed {
+            return true;
+        }
+    }
+    !found
+}
+
 /// Warning shown when the binary embeds no stubs, so a broken package
 /// says why everything built in is reported as unknown.
 pub(crate) const MISSING_STUBS_WARNING: &str = "PHPantom was built without the PHP standard library stubs, so every built-in function, class, and constant is reported as unknown. Rebuild it with network access, or with PHPANTOM_STUBS_DIR pointing at phpstorm-stubs.";
