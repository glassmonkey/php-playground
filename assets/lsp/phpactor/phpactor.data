class MongoBinData
{
    /**
     * Generic binary data.
     * @link https://php-legacy-docs.zend.com/manual/php5/en/class.mongobindata.php#mongobindata.constants.custom
     */
    public const GENERIC = 0x0;

    /**
     * Function
     * @link https://php-legacy-docs.zend.com/manual/php5/en/class.mongobindata.php#mongobindata.constants.func
     */
    public const FUNC = 0x1;

    /**
     * Generic binary data (deprecated in favor of MongoBinData::GENERIC)
     * @link https://php-legacy-docs.zend.com/manual/php5/en/class.mongobindata.php#mongobindata.constants.byte-array
     */
    public const BYTE_ARRAY = 0x2;

    /**
     * Universally unique identifier (deprecated in favor of MongoBinData::UUID_RFC4122)
     * @link https://php-legacy-docs.zend.com/manual/php5/en/class.mongobindata.php#mongobindata.constants.uuid
     */
    public const UUID = 0x3;

    /**
     * Universally unique identifier (according to » RFC 4122)
     * @link https://php-legacy-docs.zend.com/manual/php5/en/class.mongobindata.php#mongobindata.constants.custom
     */
    public const UUID_RFC4122 = 0x4;

    /**
     * MD5
     * @link https://php-legacy-docs.zend.com/manual/php5/en/class.mongobindata.php#mongobindata.constants.md5
     */
    public const MD5 = 0x5;

    /**
     * User-defined type
     * @link https://php-legacy-docs.zend.com/manual/php5/en/class.mongobindata.php#mongobindata.constants.custom
     */
    public const CUSTOM = 0x80;

    /**
     * @link https://php-legacy-docs.zend.com/manual/php5/en/class.mongobindata.php#mongobindata.props.bin
     * @var string
     */
    public $bin;

    /**
