+    let Some(scope) = scope else {
+        // The structural import context owns its item range and relative text.
+        return name.to_owned();
+    };
+    if written.starts_with('\\') {
+        return format!("\\{name}");
+    }
+    if !written.is_empty() && same_constant(&reference_identity(written, scope), name) {
+        return written.to_owned();
+    }
+    // Class imports affect only the namespace prefix of a qualified constant,
+    // never a bare constant alias. Require a nonempty remainder after '\\'.
+    let alias = scope
+        .symbol_imports
+        .constants
+        .iter()
+        .filter(|(_, target)| same_constant(target, name))
+        .map(|(alias, _)| Cow::Borrowed(alias.as_str()))
+        .chain(scope.use_map.iter().filter_map(|(alias, target)| {
+            let target = target.trim_start_matches('\\');
+            let prefix = name.get(..target.len())?;
+            if !prefix.eq_ignore_ascii_case(target)
+                || name.as_bytes().get(target.len()) != Some(&b'\\')
+            {
