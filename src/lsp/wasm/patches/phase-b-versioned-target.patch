@@ -0,0 +1,43 @@
+//! Shared, PHP-provenance-aware interpretation of stub version metadata.
+pub const PHP_DOC_MARKER: &str = "<?php /* PHPANTOM_PHP_VERSION_DOCS */ ?>\n";
+pub fn version(value: &str) -> Option<u16> {
+    let mut parts = value.trim().split('.');
+    let major = parts.next()?.parse::<u16>().ok()?;
+    let minor = parts.next()?.parse::<u16>().ok()?;
+    Some(major * 100 + minor)
+}
+pub fn doc_version(doc: &str, tag: &str, php_domain: bool) -> Option<u16> {
+    doc.lines().find_map(|line| {
+        let (_, rest) = line.split_once(tag)?;
+        let mut rest = rest.trim();
+        let explicit = rest.starts_with("PHP ");
+        if explicit {
+            rest = rest.strip_prefix("PHP ")?.trim_start();
+        }
+        if !php_domain && !explicit {
+            return None;
+        }
+        let raw = rest.split_whitespace().next()?.trim_end_matches("*/");
+        version(raw)
+    })
+}
+pub fn is_availability_attribute(name: &str, imports: &[(&str, &str)], namespace: &str) -> bool {
+    const FQN: &str = "JetBrains\\PhpStorm\\Internal\\PhpStormStubsElementAvailable";
+    if let Some(name) = name.strip_prefix('\\') {
+        return name.eq_ignore_ascii_case(FQN);
+    }
+    let first = name.split('\\').next().unwrap_or(name);
+    if let Some((_, target)) = imports
+        .iter()
+        .find(|(alias, _)| alias.eq_ignore_ascii_case(first))
+    {
+        return format!("{target}{}", &name[first.len()..]).eq_ignore_ascii_case(FQN);
+    }
+    let resolved = if namespace.is_empty() {
+        name.to_string()
+    } else {
+        format!("{namespace}\\{name}")
+    };
+    resolved.eq_ignore_ascii_case(FQN)
+        || namespace.is_empty() && name.eq_ignore_ascii_case("PhpStormStubsElementAvailable")
+}
