// test: PHPUnit's assertArrayHasKey narrows the way the array_key_exists() it stands for does
// feature: hover
// assertArrayHasKey() carries no @phpstan-assert, so it is read as the
// check it proves.
// expect: $id = int
// expect_absent: null
---
=== src/Assert.php ===
<?php
namespace PHPUnit\Framework;

abstract class Assert {
    public static function assertArrayHasKey(mixed $key, array|\ArrayAccess $array, string $message = ''): void {}
}

abstract class TestCase extends Assert {}
=== src/FooTest.php ===
<?php
use PHPUnit\Framework\TestCase;

final class FooTest extends TestCase {
    /** @param array{id?: int} $row */
    public function testRow(array $row): void {
        self::assertArrayHasKey('id', $row);
        $id = $row['id'];
        echo $i<>d;
    }
}
