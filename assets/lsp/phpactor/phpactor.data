 * @param null|array|string|object $object <p>
 *  Undocumented template parameter
 *  <p>
 * @return mixed
 */
function msgpack_unpack($str, $object = null) {}

class MessagePack
{
    public const OPT_PHPONLY = -1001;

    /**
