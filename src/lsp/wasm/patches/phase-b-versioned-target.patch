+            | "sodium"
+            | "sockets"
+            | "curl"
+            | "gd"
+            | "intl"
+            | "zip"
+            | "Phar"
+            | "PDO"
+            | "mysql"
+            | "mysqli"
+            | "pgsql"
+            | "sqlite3"
+            | "dom"
+            | "SimpleXML"
