+            assert_eq!(
+                blank
+                    .as_bytes()
+                    .iter()
+                    .filter(|&&b| matches!(b, b'\r' | b'\n'))
+                    .copied()
+                    .collect::<Vec<_>>(),
+                source
+                    .as_bytes()
+                    .iter()
+                    .filter(|&&b| matches!(b, b'\r' | b'\n'))
+                    .copied()
