 * @return bool <b>TRUE</b> on success or <b>FALSE</b> on failure.
 */
function dba_sync(#[LanguageLevelTypeAware(['8.4' => '\Dba\Connection'], default: 'resource')] $dba): bool {}

/**
 * List all the handlers available
