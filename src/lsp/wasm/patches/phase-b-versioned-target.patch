+mod original_byte_array_recovery {
+    use super::super::patch_array_access_at_cursor;
+    use tower_lsp_server::gen_lsp_types::Position;
+
+    #[test]
+    fn array_recovery_changes_only_the_original_cursor_line_and_keeps_literal_bytes() {
+        for eol in ["\n", "\r\n", "\r"] {
+            let prefix = format!("<?php{eol}$literal=\"A\r\nB\rC\n🌟\";{eol}/* 猫🌟 */ ");
+            for (input, expected, character) in [
+                ("$data[", "$data[];", 16),
+                ("$data['", "$data[''];", 17),
+                ("$data[\"", "$data[\"\"];", 17),
+                ("$data['']", "$data[''];", 17),
+                ("$data[]", "$data[];", 16),
+            ] {
+                for trailing in ["", eol] {
+                    let source = format!("{prefix}{input}  \t{eol}}}{trailing}");
+                    let wanted = format!("{prefix}{expected}  \t{eol}}}{trailing}");
+                    assert_eq!(
+                        patch_array_access_at_cursor(&source, Position::new(5, character)),
+                        wanted
+                    );
+                }
+            }
+        }
+    }
+    #[test]
+    fn no_array_pattern_or_noncanonical_coordinate_cannot_rewrite_a_buffer() {
+        let source = "<?php\r\n$literal=\"A\r\nB\rC\n🌟\";\r/* 猫🌟 */ $data[\r";
+        for position in [
+            Position::new(5, 5),
+            Position::new(5, 999),
+            Position::new(99, 0),
+            Position::new(6, 0),
+        ] {
+            assert_eq!(patch_array_access_at_cursor(source, position), source);
+        }
+        let ordinary = "<?php\r$data['name'];\r";
+        assert_eq!(
+            patch_array_access_at_cursor(ordinary, Position::new(1, 7)),
+            ordinary
+        );
+    }
+}
