+/// PHP manual language.types.declarations: declaration-site and composition availability.
+pub(crate) fn declaration_available(
+    ctx: &TypeHintContext,
+    version: crate::types::PhpVersion,
+) -> bool {
+    use crate::types::PhpVersion;
+    let min = match ctx.site {
+        TypeHintSite::Parameter => (5, 6),
+        TypeHintSite::Return => (7, 0),
+        TypeHintSite::Property => (7, 4),
+        TypeHintSite::PromotedParameter => (8, 0),
+        TypeHintSite::ClassConstant => (8, 3),
+    };
+    version >= PhpVersion::new(min.0, min.1)
+        && (!ctx.preceding_types.contains('?') || version >= PhpVersion::new(7, 1))
+        && (!ctx.preceding_types.contains('|') || version >= PhpVersion::new(8, 0))
+        && (!ctx.preceding_types.contains('&') || version >= PhpVersion::new(8, 1))
+        && (!(ctx.preceding_types.contains('&') && ctx.preceding_types.contains('|'))
+            || version >= PhpVersion::new(8, 2))
+}
+
+pub(crate) fn native_type_available(
+    ty: &str,
+    ctx: &TypeHintContext,
+    version: crate::types::PhpVersion,
+    in_class: bool,
+    has_parent: bool,
+) -> bool {
+    use crate::types::PhpVersion;
+    if !declaration_available(ctx, version) {
+        return false;
+    }
+    let union = ctx.preceding_types.contains('|');
+    let nullable = ctx.preceding_types.contains('?');
+    let mut depth = 0usize;
+    let mut last_operator = None;
+    for c in ctx.preceding_types.chars() {
+        match c {
+            '(' => depth += 1,
+            ')' => depth = depth.saturating_sub(1),
+            '|' | '&' if depth == 0 => last_operator = Some(c),
+            _ => {}
+        }
+    }
+    if depth > 0 || last_operator == Some('&') {
+        return false;
+    } // Intersections accept class names only.
+    let since = match ty {
+        "array" | "callable" | "self" | "parent" => (5, 6),
+        "string" | "int" | "float" | "bool" => (7, 0),
+        "iterable" | "void" => (7, 1),
+        "object" => (7, 2),
+        "mixed" | "static" => (8, 0),
+        "never" => (8, 1),
+        "true" => (8, 2),
+        "false" | "null" if union => (8, 0),
+        "false" | "null" => (8, 2),
+        _ => return false,
+    };
+    if version < PhpVersion::new(since.0, since.1) {
+        return false;
+    }
+    if matches!(ty, "void" | "never" | "static") && ctx.site != TypeHintSite::Return {
+        return false;
+    }
+    if matches!(
+        ctx.site,
+        TypeHintSite::Property | TypeHintSite::PromotedParameter | TypeHintSite::ClassConstant
+    ) && ty == "callable"
+    {
+        return false;
+    }
+    if ctx.site == TypeHintSite::ClassConstant && !in_class {
+        return false;
+    }
+    if matches!(ty, "self" | "parent" | "static") && !in_class {
+        return false;
+    }
+    if ty == "parent" && !has_parent {
+        return false;
+    }
+    if union && matches!(ty, "void" | "never" | "mixed")
+        || nullable && matches!(ty, "void" | "never" | "mixed" | "null")
+    {
+        return false;
+    }
+    let previous = ctx
+        .preceding_types
+        .split(['|', '&', '?'])
+        .map(str::trim)
+        .collect::<Vec<_>>();
+    if previous.iter().any(|p| p.eq_ignore_ascii_case(ty)) {
+        return false;
+    }
+    if previous.contains(&"mixed") || previous.contains(&"never") || previous.contains(&"void") {
+        return false;
+    }
+    if ty == "bool" && (previous.contains(&"true") || previous.contains(&"false"))
+        || matches!(ty, "true" | "false") && previous.contains(&"bool")
+        || ty == "true" && previous.contains(&"false")
+        || ty == "false" && previous.contains(&"true")
+        || ty == "array" && previous.contains(&"iterable")
+        || ty == "iterable" && previous.contains(&"array")
+    {
+        return false;
+    }
+    true
+}
