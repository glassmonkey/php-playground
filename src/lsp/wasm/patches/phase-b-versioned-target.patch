+        assert_eq!(
+            constant_spelling("Vendor\\TOKEN", "\\Vendor\\TOKEN", "", Some(&scope)),
+            "\\Vendor\\TOKEN"
+        );
+        assert_eq!(
+            constant_spelling("Vendor\\TOKEN", "TOKEN", "vendor\\to", None),
+            "Vendor\\TOKEN"
+        );
+    }
+}
