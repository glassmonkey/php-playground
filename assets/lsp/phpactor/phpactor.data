 * @link https://php-legacy-docs.zend.com/manual/php5/en/mssql.constants
 */
define('SQLFLT4', 59);

/**
 * Represents an eight byte float.
 * @link https://php-legacy-docs.zend.com/manual/php5/en/mssql.constants
 */
define('SQLFLT8', 62);
define('SQLFLTN', 109);

