// test: an object compared greater than a nullable value leaves no null in the else arm
// feature: hover
// An object is always greater than null, so the arm that runs when the
// comparison fails only sees a non-null $t, inside a loop as outside one.
// expect: $kept = DateTimeImmutable
// expect_absent: null
---
<?php

/** @param list<array{ts?: string}> $rows */
function latest(array $rows, DateTimeImmutable $last): void {
    foreach ($rows as $row) {
        $t = isset($row['ts']) ? new DateTimeImmutable($row['ts']) : null;
        $last = $last > $t ? $last : $t;
    }
    $kept = $last;
    echo $ke<>pt;
}
