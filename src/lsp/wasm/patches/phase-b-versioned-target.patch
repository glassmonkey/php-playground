+/// Keep the complete type fragment after const, including nullable/union/intersection/DNF.
+/// A following identifier after a complete type is a constant name, not another type.
+fn class_constant_type_context(chars: &[char], cursor: usize) -> Option<TypeHintContext> {
+    let start = chars[..cursor]
+        .iter()
+        .rposition(|c| matches!(c, ';' | '{' | '}'))
+        .map_or(0, |p| p + 1);
+    let segment = &chars[start..cursor];
+    let mut constant_end = None;
+    for i in 0..segment.len().saturating_sub(4) {
+        if segment[i..i + 5]
+            .iter()
+            .zip("const".chars())
+            .all(|(a, b)| a.eq_ignore_ascii_case(&b))
+            && (i == 0 || !is_identifier_char(segment[i - 1]))
+            && (i + 5 == segment.len() || !is_identifier_char(segment[i + 5]))
+        {
+            constant_end = Some(start + i + 5);
+        }
+    }
+    let anchor = constant_end?;
+    if chars[anchor..cursor]
+        .iter()
+        .any(|c| matches!(c, '=' | ',' | '$'))
+    {
+        return None;
+    }
+    let mut partial_start = cursor;
+    while partial_start > anchor && is_identifier_char(chars[partial_start - 1]) {
+        partial_start -= 1;
+    }
+    let partial = chars[partial_start..cursor].iter().collect::<String>();
+    let preceding = chars[anchor..partial_start].iter().collect::<String>();
+    let preceding = preceding.trim();
+    if preceding.is_empty() {
+        if !partial.starts_with(|c: char| c.is_ascii_lowercase())
+            || !PHP_NATIVE_TYPES.iter().any(|ty| ty.starts_with(&partial))
+        {
+            return None;
+        }
+    } else if !preceding.ends_with(['?', '|', '&', '(']) {
+        return None;
+    }
+    Some(TypeHintContext {
+        partial,
+        needs_space_prefix: false,
+        site: TypeHintSite::ClassConstant,
+        preceding_types: preceding.to_string(),
+    })
+}
+
+fn is_identifier_char(c: char) -> bool {
+    c.is_alphanumeric() || matches!(c, '_' | '\\')
