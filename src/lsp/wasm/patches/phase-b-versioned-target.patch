+        let mut scope = FileContext {
+            namespace: Some("App".into()),
+            ..FileContext::default()
+        };
+        scope
+            .symbol_imports
+            .constants
+            .insert("S".into(), "Vendor\\TOKEN".into());
+        scope
+            .symbol_imports
+            .constants
+            .insert("LONG_ALIAS".into(), "Vendor\\TOKEN".into());
+        scope.use_map.insert("P".into(), "Vendor".into());
+        scope
+            .use_map
+            .insert("LONG_NAMESPACE".into(), "Vendor".into());
+        assert_eq!(
+            constant_spelling("Vendor\\TOKEN", "LONG_AL", "long_al", Some(&scope)),
+            "LONG_ALIAS"
+        );
+        assert_eq!(
+            constant_spelling(
+                "Vendor\\TOKEN",
+                "LONG_NAMESPACE\\TOK",
+                "long_namespace\\tok",
+                Some(&scope)
