{
  "name": "php-playground",
  "version": "0.1.0",
  "engines": {
    "node": "24.12.0"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@chakra-ui/icons": "2.1.0",
    "@chakra-ui/react": "2.8.0",
    "@codemirror/language": "6.12.1",
    "@codesandbox/sandpack-react": "2.20.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@monaco-editor/react": "4.7.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "29.5.14",
    "@types/lz-string": "1.5.0",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.7",
    "debounce": "2.2.0",
    "framer-motion": "12.43.0",
    "lz-string": "1.5.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "5.5.0",
    "react-router-dom": "7.18.4",
    "react-select": "5.9.0",
    "typescript": "5.9.3",
    "web-vitals": "5.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview --port 8888",
    "build:types": "npm run clean:types; npm-run-all --parallel build:types:*",
    "build:types:general": "tsc -p ./tsconfig.json",
    "clean": "npm-run-all --parallel clean:*",
    "clean:all": "rm -rf build/* ./build-*/*",
    "clean:types": "rm -rf build-types/* *.tsbuildinfo",
    "format": "prettier --write src",
    "lint:js": "eslint \"./src/**/*.{js,mjs,ts}\"",
    "lint:js:fix": "npm run lint:js -- --fix",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/debounce": "1.2.4",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/web-worker": "4.1.12",
    "esbuild": "0.28.1",
    "eslint": "8.57.0",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "^25.0.1",
    "node-fetch": "3.3.2",
    "vi-fetch": "0.8.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
