diff --git a/src/completion/context/import_context.rs b/src/completion/context/import_context.rs
--- a/src/completion/context/import_context.rs
+++ b/src/completion/context/import_context.rs
@@ -0,0 +1,374 @@
+//! The active import item, shared by classification, candidate search and edits.
+use mago_allocator::LocalArena;
+use mago_database::file::FileId;
+use mago_span::HasSpan;
+use mago_syntax::cst::{Node, UseItem, UseItems, UseType};
+use mago_syntax::settings::ParserSettings;
+use tower_lsp_server::gen_lsp_types::*;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ImportKind {
+    Class,
+    Function,
+    Const,
+    Trait,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ImportContext {
+    pub kind: ImportKind,
+    pub group_prefix: Option<String>,
+    pub prefix: String,
+    pub range: Range,
+    pub append_semicolon: bool,
+}
+
+fn kind(value: Option<&UseType<'_>>) -> ImportKind {
+    match value {
+        Some(UseType::Function(_)) => ImportKind::Function,
+        Some(UseType::Const(_)) => ImportKind::Const,
+        None => ImportKind::Class,
+    }
+}
+
+impl ImportContext {
+    pub fn search_prefix(&self) -> String {
+        match &self.group_prefix {
+            Some(group) => format!("{group}\\{}", self.prefix),
+            None => self.prefix.clone(),
+        }
+    }
+
+    /// Importing a symbol is not invoking it or adding another use statement.
+    /// Preserve the canonical data used by resolve, but own every edit field.
+    pub fn edit_items(&self, items: Vec<CompletionItem>) -> Vec<CompletionItem> {
+        items
+            .into_iter()
+            .filter_map(|mut item| {
+                let fqn = item
+                    .data
+                    .as_ref()
+                    .and_then(|d| d.get("m"))
+                    .and_then(|v| v.as_str())
+                    .or_else(|| {
+                        (item.kind == Some(CompletionItemKind::Module))
+                            .then_some(item.filter_text.as_deref())
+                            .flatten()
+                    })?;
+                let fqn = fqn.trim_start_matches('\\');
+                let relative = if let Some(group) = &self.group_prefix {
+                    let head = fqn.get(..group.len())?;
+                    if !head.eq_ignore_ascii_case(group)
+                        || fqn.as_bytes().get(group.len()) != Some(&b'\\')
+                    {
+                        return None;
+                    }
+                    &fqn[group.len() + 1..]
+                } else {
+                    fqn
+                };
+                let mut text = relative.to_owned();
+                if item.kind == Some(CompletionItemKind::Module) {
+                    if !text.ends_with('\\') {
+                        text.push('\\');
+                    }
+                } else if self.append_semicolon {
+                    text.push(';');
+                }
+                item.filter_text = Some(relative.to_owned());
+                item.insert_text = Some(text.clone());
+                item.insert_text_format = Some(InsertTextFormat::PlainText);
+                item.insert_text_mode = None;
+                item.text_edit = Some(CompletionItemTextEdit::TextEdit(TextEdit {
+                    range: self.range,
+                    new_text: text,
+                }));
+                item.text_edit_text = None;
+                item.additional_text_edits = None;
+                item.command = None;
+                Some(item)
+            })
+            .collect()
+    }
+}
+
+fn item_context(
+    content: &str,
+    cursor: usize,
+    kind: ImportKind,
+    group_prefix: Option<String>,
+    item: &UseItem<'_>,
+) -> Option<ImportContext> {
+    let span = item.name.span();
+    let start = span.start.offset as usize;
+    if cursor < start || cursor > span.end.offset as usize {
+        return None;
+    }
+    // Retain the rest of a name when completion is requested mid-token. An
+    // alias and neighbouring group items are outside this replacement range.
+    let mut end = cursor;
+    let bytes = content.as_bytes();
+    while end < bytes.len() && (crate::text_scan::is_ident_byte(bytes[end]) || bytes[end] == b'\\')
+    {
+        end += 1;
+    }
+    let following = crate::text_scan::skip_php_trivia(bytes, end);
+    let append_semicolon = group_prefix.is_none()
+        && !matches!(bytes.get(following), Some(b';' | b','))
+        && !crate::text_scan::keyword_starts_at(bytes, following, b"as");
+    Some(ImportContext {
+        kind,
+        group_prefix,
+        prefix: content[start..cursor].to_owned(),
+        range: Range {
+            start: crate::text_position::offset_to_position(content, start),
+            end: crate::text_position::offset_to_position(content, end),
+        },
+        append_semicolon,
+    })
+}
+
+pub(crate) fn detect_import_context(content: &str, position: Position) -> Option<ImportContext> {
+    let cursor =
+        (crate::text_position::position_to_offset(content, position) as usize).min(content.len());
+    let prefix = &content[..cursor];
+    if !prefix
+        .as_bytes()
+        .windows(3)
+        .any(|w| w.eq_ignore_ascii_case(b"use"))
+    {
+        return None;
+    }
+    crate::util::catch_panic_unwind_safe("completion import context", "<completion>", None, || {
+        // A group closes BEFORE its statement terminator; class/namespace
+        // owners close AFTER it. Try the two grammar forms, accepting only
+        // the matching CST shape. A synthetic identifier also retains an
+        // empty item after `{`, `,`, or its kind keyword. Only the source up
+        // to the real cursor is used as the search prefix and edit range.
+        let closing = "}".repeat(prefix.bytes().filter(|&b| b == b'{').count());
+        for grouped in [true, false] {
+            let recoverable = if grouped {
+                format!("{prefix}__phpantom_completion__}};{closing}")
+            } else {
+                format!("{prefix}__phpantom_completion__;{closing}")
+            };
+            let arena = LocalArena::new();
+            let program = mago_syntax::parser::parse_file_content_with_settings(
+                &arena,
+                FileId::new(b"completion-import.php"),
+                recoverable.as_bytes(),
+                ParserSettings {
+                    recover_incomplete: true,
+                    ..Default::default()
+                },
+            );
+            let mut nodes = vec![Node::Program(program)];
+            while let Some(node) = nodes.pop() {
+                let span = node.span();
+                if cursor < span.start.offset as usize || cursor > span.end.offset as usize {
+                    continue;
+                }
+                match node {
+                    Node::Use(import)
+                        if cursor <= import.terminator.span().start.offset as usize =>
+                    {
+                        let result = match &import.items {
+                            UseItems::Sequence(items) if !grouped => {
+                                items.items.iter().find_map(|item| {
+                                    item_context(content, cursor, ImportKind::Class, None, item)
+                                })
+                            }
+                            UseItems::TypedSequence(items) if !grouped => {
+                                items.items.iter().find_map(|item| {
+                                    item_context(
+                                        content,
+                                        cursor,
+                                        kind(Some(&items.r#type)),
+                                        None,
+                                        item,
+                                    )
+                                })
+                            }
+                            UseItems::TypedList(items) if grouped => {
+                                let group = String::from_utf8_lossy(items.namespace.value())
+                                    .trim_start_matches('\\')
+                                    .to_owned();
+                                items.items.iter().find_map(|item| {
+                                    item_context(
+                                        content,
+                                        cursor,
+                                        kind(Some(&items.r#type)),
+                                        Some(group.clone()),
+                                        item,
+                                    )
+                                })
+                            }
+                            UseItems::MixedList(items) if grouped => {
+                                let group = String::from_utf8_lossy(items.namespace.value())
+                                    .trim_start_matches('\\')
+                                    .to_owned();
+                                items.items.iter().find_map(|item| {
+                                    item_context(
+                                        content,
+                                        cursor,
+                                        kind(item.r#type.as_ref()),
+                                        Some(group.clone()),
+                                        &item.item,
+                                    )
+                                })
+                            }
+                            _ => None,
+                        };
+                        if result.is_some() {
+                            return result;
+                        }
+                    }
+                    Node::TraitUse(import)
+                        if !grouped
+                            && cursor <= import.specification.span().start.offset as usize =>
+                    {
+                        return Some(ImportContext {
+                            kind: ImportKind::Trait,
+                            group_prefix: None,
+                            prefix: String::new(),
+                            range: Range {
+                                start: position,
+                                end: position,
+                            },
+                            append_semicolon: false,
+                        });
+                    }
+                    Node::ClosureUseClause(_) => {}
+                    _ => node.visit_children(|child| nodes.push(child)),
+                }
+            }
+        }
+        None
+    })
+    .flatten()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn at_end(source: &str) -> Option<ImportKind> {
+        let lines = source.split('\n').collect::<Vec<_>>();
+        detect_import_context(
+            source,
+            Position {
+                line: lines.len() as u32 - 1,
+                character: lines.last().unwrap().encode_utf16().count() as u32,
+            },
+        )
+        .map(|context| context.kind)
+    }
+    #[test]
+    fn comments_preserve_namespace_import_kinds() {
+        for (suffix, expected) in [
+            ("use /*x*/ const str", ImportKind::Const),
+            ("use /*x*/ function str", ImportKind::Function),
+            ("use /*x*/ Vendor\\str", ImportKind::Class),
+        ] {
+            assert_eq!(
+                at_end(&format!("<?php namespace App; {suffix}")),
+                Some(expected)
+            );
+            assert_eq!(
