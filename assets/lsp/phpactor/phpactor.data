 * @link https://php.net/manual/en/filter.constants.php
 */
define('FILTER_FLAG_ENCODE_LOW', 16);

/**
 * Encode characters with ASCII value greater than 127.
 * @link https://php.net/manual/en/filter.constants.php
 */
define('FILTER_FLAG_ENCODE_HIGH', 32);

/**
