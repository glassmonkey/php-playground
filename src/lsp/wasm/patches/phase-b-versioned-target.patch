+// Constant names are case-sensitive; their namespace parts are not.
+fn same_constant(a: &str, b: &str) -> bool {
+    let a = a.trim_start_matches('\\');
+    let b = b.trim_start_matches('\\');
+    let (a_ns, a_name) = a.rsplit_once('\\').unwrap_or(("", a));
+    let (b_ns, b_name) = b.rsplit_once('\\').unwrap_or(("", b));
+    a_name == b_name && a_ns.eq_ignore_ascii_case(b_ns)
+}
+
+/// The first binding of a written constant name, without loading symbols or
+/// comparing their values. Bare global fallback is deliberately not assumed.
+fn reference_identity(name: &str, scope: &crate::types::FileContext) -> String {
+    if let Some(absolute) = name.strip_prefix('\\') {
+        return absolute.to_owned();
+    }
+    if let Some((first, rest)) = name.split_once('\\') {
+        if first.eq_ignore_ascii_case("namespace") {
+            return scope
+                .namespace
+                .as_ref()
+                .map_or_else(|| rest.to_owned(), |ns| format!("{ns}\\{rest}"));
+        }
+        return crate::names::resolve_to_fqn(name, &scope.use_map, &scope.namespace);
+    }
+    if let Some(imported) = scope.symbol_imports.constants.get(name) {
+        return imported.clone();
+    }
+    scope
+        .namespace
+        .as_ref()
+        .map_or_else(|| name.to_owned(), |ns| format!("{ns}\\{name}"))
+}
+
+fn constant_spelling(
+    name: &str,
+    written: &str,
+    prefix_lower: &str,
+    scope: Option<&crate::types::FileContext>,
