// test: PHPUnit's assertArrayNotHasKey drops the optional key it proves absent
// feature: hover
// expect: array{name: string}
// expect_absent: id
---
=== src/Assert.php ===
<?php
namespace PHPUnit\Framework;

abstract class Assert {
    public static function assertArrayNotHasKey(mixed $key, array|\ArrayAccess $array, string $message = ''): void {}
}

abstract class TestCase extends Assert {}
=== src/FooTest.php ===
<?php
use PHPUnit\Framework\TestCase;

final class FooTest extends TestCase {
    /** @param array{id?: int, name: string} $row */
    public function testRow(array $row): void {
        $this->assertArrayNotHasKey('id', $row);
        echo $r<>ow;
    }
}
