 * </p>
 * @return bool <p>
 * Returns true on success or false on failure.
 * </p>
 */
function cubrid_field_seek($result, $field_offset = 0) {}

/**
 * (PHP 5, CUBRID &gt;= 8.3.0)<br/>
 * Free the memory occupied by the result data
