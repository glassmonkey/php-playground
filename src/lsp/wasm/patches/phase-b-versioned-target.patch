+            | "fileinfo"
+            | "zlib"
+            | "bz2"
+            | "openssl"
+            | "sodium"
+            | "sockets"
+            | "curl"
+            | "gd"
+            | "intl"
+            | "zip"
+            | "Phar"
+            | "PDO"
+            | "mysql"
+            | "mysqli"
+            | "pgsql"
+            | "sqlite3"
+            | "dom"
+            | "SimpleXML"
+            | "xml"
+            | "xmlreader"
+            | "xmlwriter"
+            | "xsl"
