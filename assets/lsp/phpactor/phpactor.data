    public function __construct(Criteria ...$criterias)
    {
        $this->criterias = $criterias;
    }

    public function isSatisfiedBy(Record $record): bool
    {
        foreach ($this->criterias as $criteria) {
            if (true === $criteria->isSatisfiedBy($record)) {
                return true;
            }
