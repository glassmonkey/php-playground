+/* zend_list_free() returns int, but the table below calls every destructor
+ * through a function pointer returning void. WebAssembly traps when an
+ * indirect call does not match the callee's signature, so wrap it. */
+static void ZEND_FASTCALL zend_list_free_dtor(zend_resource *res)
+{
+	zend_list_free(res);
+}
