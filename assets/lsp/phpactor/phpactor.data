 * feof). If the call fails, it will return false
 */
function fsockopen(
    string $hostname,
    #[PhpStormStubsElementAvailable(from: '5.3', to: '7.0')] int $port = -1,
    #[PhpStormStubsElementAvailable(from: '7.1')] int $port = -1,
