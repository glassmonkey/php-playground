     *
     * @see https://redis.io/docs/latest/commands/hgetex/
     *
     * @example
     * $redis->hgetex('profiles', ['name', 'email'], ['EX' => 60]);
     */
    public function hgetex(string $key, array $fields, string|array|null $expiry = null): Redis|array|false {}

