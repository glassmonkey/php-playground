    ?string $content = null,
    #[PhpStormStubsElementAvailable("7.2")] ?string $output_filename = null
): int|bool {}

/**
 * Decrypts an S/MIME encrypted message
 * @link https://php.net/manual/en/function.openssl-pkcs7-decrypt.php
 * @param string $input_filename
