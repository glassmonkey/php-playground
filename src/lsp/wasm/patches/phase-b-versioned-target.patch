+#[cfg(test)]
+mod release_regressions {
+    use super::*;
+    #[test]
+    fn all_constant_declarators_share_the_statement_metadata() {
+        let e = entries(
+            "<?php /** @since 8.4 */ const A = [1, 2], B = 2, C = foo(1, 2);",
+            true,
+        );
+        assert_eq!(
+            e.iter()
+                .map(|e| (e.name.as_str(), e.from))
+                .collect::<Vec<_>>(),
+            vec![("A", 804), ("B", 804), ("C", 804)]
+        );
+    }
+    #[test]
+    fn grouped_availability_import_resolves_its_own_alias() {
+        let src = r"<?php use JetBrains\PhpStorm\Internal\{Other, PhpStormStubsElementAvailable as Available}; #[Available(from: '8.4')] function future() {}";
+        assert_eq!(entries(src, true)[0].from, 804);
+    }
+    #[test]
+    fn imports_do_not_leak_between_namespace_scopes() {
+        let src = r"<?php namespace A { use JetBrains\PhpStorm\Internal\PhpStormStubsElementAvailable as Available; #[Available(from:'8.4')] function future() {} } namespace B { use Other\Available; #[Available(from:'8.4')] function existing() {} }";
+        assert_eq!(
+            entries(src, true)
+                .iter()
+                .map(|e| (e.name.as_str(), e.from))
+                .collect::<Vec<_>>(),
+            vec![("A\\future", 804), ("B\\existing", 0)]
+        );
+    }
+    #[test]
+    fn heredoc_and_nowdoc_contents_never_become_declarations_or_imports() {
+        let src = "<?php $s=<<<TXT\n/** @since 8.5 */ function phantom() {}\nuse Wrong\\Available;\nTXT;\n$s=<<<'RAW'\nclass Phantom {}\nfunction phantom_again() {}\nRAW;\nfunction real() {}";
+        assert_eq!(
+            entries(src, true)
+                .iter()
+                .map(|e| e.name.as_str())
+                .collect::<Vec<_>>(),
+            vec!["real"]
+        );
+    }
+    #[test]
+    fn anonymous_class_members_and_quoted_declarations_are_not_global_functions() {
+        let src = r#"<?php $x = new class { function member() {} }; $s="function quoted() {}"; $f = function () use ($x) {}; function real() {}"#;
+        assert_eq!(
+            entries(src, true)
+                .iter()
+                .map(|e| e.name.as_str())
+                .collect::<Vec<_>>(),
+            vec!["real"]
+        );
+    }
+}
+
+#[cfg(test)]
+mod ownership_regressions {
+    use super::*;
+    #[test]
+    fn anonymous_extends_and_class_name_literals_do_not_change_declaration_ownership() {
+        let source = "<?php $x=new class extends Base { function member() {} }; Foo::class; function enum() {} function real() {}";
+        let names = entries(source, true)
+            .into_iter()
+            .map(|e| (e.kind, e.name))
+            .collect::<Vec<_>>();
+        assert_eq!(
+            names,
+            vec![
+                ("function", "enum".to_string()),
+                ("function", "real".to_string())
+            ]
+        );
+    }
+}
+
+#[cfg(test)]
+mod nested_owner_regressions {
+    use super::*;
+    #[test]
+    fn nested_anonymous_classes_restore_the_enclosing_owner() {
+        let source = "<?php namespace N { class Outer { function first() { $x=new class { function nested(){ $y=new class { function inner(){} }; } }; } /** @since 8.4 */ function outerMethod() {} /** @since 8.4 */ const OUTER_CONST=1; } function real() {} const TOP=1; }";
+        let entries = entries(source, true);
+        assert_eq!(
+            entries
+                .iter()
+                .map(|e| (e.kind, e.name.as_str()))
+                .collect::<Vec<_>>(),
+            vec![
+                ("class", "N\\Outer"),
+                ("function", "N\\real"),
+                ("constant", "N\\TOP")
+            ]
+        );
+    }
+    #[test]
+    fn nested_named_class_restores_outer_method_and_constant_ownership() {
+        let source = "<?php class Outer { function first() { class Inner { function inner() {} const INNER=1; } } /** @since 8.4 */ function outerMethod() {} const OUTER_CONST=1; } function real() {} const TOP=1;";
+        let entries = entries(source, true);
+        assert_eq!(
+            entries
+                .iter()
+                .filter(|e| e.kind != "class")
+                .map(|e| (e.kind, e.name.as_str()))
+                .collect::<Vec<_>>(),
+            vec![("function", "real"), ("constant", "TOP")]
+        );
+    }
+}
