+    // checks can distinguish PHP's bundled core stubs from extension stubs.
+    out.push_str("/// Paths corresponding to [`STUB_FILES`].\n");
+    out.push_str(&format!(
+        "pub(crate) static STUB_FILE_PATHS: [&str; {}] = [\n",
+        existing_files.len()
