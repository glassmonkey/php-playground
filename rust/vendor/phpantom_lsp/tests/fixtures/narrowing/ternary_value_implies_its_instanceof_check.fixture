// test: a value a ternary paired with an instanceof check implies the check
// feature: hover
// $problems is only non-empty when the instanceof arm ran, the same as
// when the value is assigned in an if/else on that check.
// expect: $kept = Sheet
---
<?php

class Import {}
class Sheet extends Import {
    /** @return list<string> */
    public function problems(): array { return []; }
}

function report(Import $importer): void {
    $problems = $importer instanceof Sheet ? $importer->problems() : [];
    if ($problems !== []) {
        $kept = $importer;
        echo $ke<>pt;
    }
}
