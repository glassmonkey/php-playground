 * </p>
 * @return int <p>
 * Maximum length, when process is successful. FALSE on failure.
 * </p>
 */
function cubrid_field_len($result, $field_offset) {}

/**
 * (PHP 5, CUBRID &gt;= 8.3.0)<br/>
 * Return the type of the column corresponding to the given field offset
