// test: is_subclass_of() on a string narrows it to a class-string of the checked class
// feature: hover
// is_subclass_of() accepts a class name by default, so a passing string
// names a subclass, the same as is_a() with its third argument set.
// expect: $kept = class-string<Countable>
---
<?php

function check(string $cls): void {
    if (!is_subclass_of($cls, \Countable::class)) {
        return;
    }
    $kept = $cls;
    echo $ke<>pt;
}
