namespace LibDNS\Messages;

use \LibDNS\Records\RecordCollectionFactory;

/**
 * Factory which creates Message objects
 *
 * @category LibDNS
 * @package Messages
 * @author Chris Wright <https://github.com/DaveRandom>
 */
class MessageFactory
{
    /**
