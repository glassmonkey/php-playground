+
+/// PHP identifier continuation characters (PHP permits every non-ASCII byte).
+pub(crate) fn is_php_name_char(ch: char) -> bool {
+    ch.is_ascii_alphanumeric() || ch == '_' || !ch.is_ascii()
+}
+
+/// Replace the exact written prefix and its lexical suffix, at a valid UTF-16
+/// cursor. A stale prefix or a cursor inside a surrogate pair cannot edit text.
+pub(crate) fn name_replacement_range(
+    content: &str,
+    position: tower_lsp_server::gen_lsp_types::Position,
+    prefix: &str,
+    accepts: impl Fn(char) -> bool,
+) -> Option<tower_lsp_server::gen_lsp_types::Range> {
+    let cursor = crate::text_position::position_to_byte_offset(content, position);
+    if crate::text_position::offset_to_position(content, cursor) != position {
+        return None;
+    }
+    let start = cursor.checked_sub(prefix.len())?;
+    if content.get(start..cursor)? != prefix {
+        return None;
+    }
+    let start_position = crate::text_position::offset_to_position(content, start);
+    if start_position.line != position.line {
+        return None;
+    }
+    let suffix_bytes = content
+        .get(cursor..)?
+        .chars()
+        .take_while(|&ch| accepts(ch))
+        .map(char::len_utf8)
+        .sum::<usize>();
+    Some(tower_lsp_server::gen_lsp_types::Range {
+        start: start_position,
+        end: crate::text_position::offset_to_position(content, cursor + suffix_bytes),
+    })
+}
+
+#[cfg(test)]
+mod replacement_range_tests {
+    use super::{is_php_name_char, name_replacement_range};
+    use tower_lsp_server::gen_lsp_types::{Position, Range};
+
+    #[test]
+    fn current_utf16_word_range_covers_its_right_suffix() {
+        let content = "<?php\n🌟 FooBar";
+        for (character, prefix) in [(3, ""), (6, "Foo"), (9, "FooBar")] {
+            assert_eq!(
+                name_replacement_range(
+                    content,
+                    Position { line: 1, character },
+                    prefix,
+                    is_php_name_char
+                ),
+                Some(Range {
+                    start: Position {
+                        line: 1,
+                        character: 3
+                    },
+                    end: Position {
+                        line: 1,
+                        character: 9
+                    }
+                })
+            );
+        }
+    }
+
+    #[test]
+    fn stale_prefix_and_noncanonical_utf16_coordinates_cannot_edit() {
+        let content = "<?php\n🌟 FooBar";
+        for (line, character, prefix) in [(1, 6, "Fox"), (1, 1, ""), (1, 99, "FooBar"), (99, 0, "")]
+        {
+            assert_eq!(
+                name_replacement_range(
+                    content,
+                    Position { line, character },
+                    prefix,
+                    is_php_name_char
+                ),
+                None
+            );
+        }
+    }
+}
