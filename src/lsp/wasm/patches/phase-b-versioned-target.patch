+#[cfg(test)]
+mod release_regressions {
+    use super::*;
+    #[test]
+    fn all_constant_declarators_share_the_statement_metadata() {
+        let e = entries(
+            "<?php /** @since 8.4 */ const A = [1, 2], B = 2, C = foo(1, 2);",
