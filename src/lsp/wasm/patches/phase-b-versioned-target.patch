+fn existing_name_at_cursor(content: &str, position: Position) -> bool {
+    let cursor = crate::text_position::position_to_byte_offset(content, position);
+    if crate::text_position::offset_to_position(content, cursor) != position {
+        return false;
+    }
+    let rest = &content[cursor..];
+    let Some(first) = rest.chars().next() else {
+        return false;
+    };
+    if !(first.is_ascii_alphabetic() || first == '_' || first == '\\' || !first.is_ascii()) {
+        return false;
+    }
+    let suffix_bytes = rest
+        .chars()
+        .take_while(|&ch| crate::completion::is_php_name_char(ch) || ch == '\\')
+        .map(char::len_utf8)
+        .sum::<usize>();
+    let end = crate::text_position::offset_to_position(content, cursor + suffix_bytes);
+    Backend::extract_partial_class_name(content, end).is_some()
+}
