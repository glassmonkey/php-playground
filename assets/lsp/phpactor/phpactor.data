use Phpactor\CodeBuilder\Domain\Prototype\InterfacePrototype;
use Phpactor\CodeBuilder\Domain\Prototype\UpdatePolicy;

class InterfaceBuilder extends ClassLikeBuilder
{
    /**
     * @var Type[]
     */
