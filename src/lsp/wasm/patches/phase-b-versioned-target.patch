+        | "empty" | "eval" | "exit" | "extends" | "final" | "finally" | "for" | "foreach"
+        | "function" | "global" | "goto" | "if" | "implements" | "include" | "include_once"
+        | "instanceof" | "interface" | "isset" | "list" | "namespace" | "new" | "print"
+        | "private" | "protected" | "public" | "require" | "require_once" | "return" | "static"
+        | "switch" | "throw" | "trait" | "try" | "unset" | "use" | "while" | "yield" => (5, 6),
